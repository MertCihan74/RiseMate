<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ana mor gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="160"
                android:startColor="#6200EE"
                android:centerColor="#7C4DFF"
                android:endColor="#9C27B0" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Üst kısımda hafif parlak overlay -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="400dp"
                android:centerX="0.3"
                android:centerY="0.1"
                android:startColor="#40FFFFFF"
                android:endColor="@android:color/transparent" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Alt kısımda koyu overlay (okunabilirlik için) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#60000000"
                android:centerColor="#20000000"
                android:endColor="@android:color/transparent" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>








