<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="160"
                android:endColor="#F5F0FF"
                android:centerColor="#FFFFFF"
                android:startColor="#EDE7F6"
                android:type="linear" />
        </shape>
    </item>
    <!-- Top decorative circle -->
    <item
        android:top="-200dp"
        android:right="-100dp">
        <shape android:shape="oval">
            <solid android:color="#15673AB7" />
            <size
                android:width="400dp"
                android:height="400dp" />
        </shape>
    </item>
    <!-- Bottom decorative circle -->
    <item
        android:bottom="-150dp"
        android:left="-100dp">
        <shape android:shape="oval">
            <solid android:color="#109C27B0" />
            <size
                android:width="350dp"
                android:height="350dp" />
        </shape>
    </item>
</layer-list>








