<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ana mor arka plan -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#6200EE" />
            <corners
                android:bottomLeftRadius="24dp"
                android:bottomRightRadius="24dp" />
        </shape>
    </item>
    <!-- Sağ üst köşede hafif gradient overlay -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="300dp"
                android:centerX="0.9"
                android:centerY="0.2"
                android:startColor="#309C27B0"
                android:endColor="@android:color/transparent" />
            <corners
                android:bottomLeftRadius="24dp"
                android:bottomRightRadius="24dp" />
        </shape>
    </item>
    <!-- Sol alt köşede hafif açık gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="200dp"
                android:centerX="0.1"
                android:centerY="0.8"
                android:startColor="#207C4DFF"
                android:endColor="@android:color/transparent" />
            <corners
                android:bottomLeftRadius="24dp"
                android:bottomRightRadius="24dp" />
        </shape>
    </item>
</layer-list>








